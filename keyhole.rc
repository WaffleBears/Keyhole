#define RT_MANIFEST 24
#define APP_MANIFEST_ID 1
#define APP_ICON_ID 1

APP_MANIFEST_ID RT_MANIFEST "keyhole.manifest"
APP_ICON_ID ICON "assets/keyhole.ico"

1 VERSIONINFO
FILEVERSION 1,1,8,0
PRODUCTVERSION 1,1,8,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Keyhole"
      VALUE "FileDescription", "Keyhole server admin console"
      VALUE "FileVersion", "1.1.8.0"
      VALUE "InternalName", "keyhole"
      VALUE "OriginalFilename", "keyhole.exe"
      VALUE "ProductName", "Keyhole"
      VALUE "ProductVersion", "1.1.8"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
