import { CheckBox, ScrollView } from "std-widgets.slint";
import { Theme, Tips } from "theme.slint";
import { BarRow, Badge, Chip, Pill, Metric } from "types.slint";

export component TipArea inherits TouchArea {
    in property <string> tip;
    changed has-hover => {
        if self.has-hover && root.tip != "" {
            Tips.hover(root.tip, self.absolute-position.x, self.absolute-position.y + self.height);
        } else {
            Tips.leave();
        }
    }
}

export component ToolButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> tip;
    in property <bool> active;
    in property <bool> icon-only;
    in property <int> dot;
    in property <length> min-w: 0px;
    callback clicked();
    height: 30px;
    width: max(root.min-w, icon-only ? 32px : lbl.preferred-width + 24px + (dot > 0 ? 14px : 0px) + (icon != "" ? 18px : 0px));
    border-radius: Theme.radius;
    background: active ? Theme.accent-soft : ta.has-hover ? Theme.control-hover : Theme.control;
    border-width: 1px;
    border-color: active ? Theme.accent.with-alpha(0.5) : Theme.control-line;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: icon-only ? 0px : 11px;
        padding-right: icon-only ? 0px : 11px;
        spacing: 7px;
        alignment: center;
        if dot > 0: Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - 7px) / 2;
            border-radius: 4px;
            background: dot == 1 ? Theme.good : dot == 2 ? Theme.warn : Theme.dim;
        }
        lbl := Text {
            text: root.text;
            color: active ? Theme.accent : Theme.text;
            font-size: root.icon-only ? 14px : Theme.font;
            font-family: root.icon-only ? Theme.icons : Theme.ui-font;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        if root.icon != "" && !root.icon-only: Text { text: root.icon; color: Theme.muted; font-size: 10px; font-family: Theme.icons; vertical-alignment: center; }
    }
    ta := TipArea { tip: root.tip; clicked => { root.clicked(); } }
}

export component ChipButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> tip;
    in property <bool> active;
    in property <bool> danger;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 26px;
    width: lbl.preferred-width + 22px + (icon != "" ? 16px : 0px);
    border-radius: 7px;
    opacity: enabled ? 1 : 0.45;
    background: primary ? (ta.has-hover ? Theme.accent : Theme.accent.with-alpha(0.9)) : active ? Theme.chip-on : ta.has-hover ? Theme.control-hover : Theme.control;
    border-width: primary ? 0px : 1px;
    border-color: active ? Theme.accent.with-alpha(0.5) : danger ? Theme.bad.with-alpha(0.35) : Theme.control-line;
    animate background { duration: 120ms; }
    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        lbl := Text {
            text: root.text;
            color: primary ? #1a1200 : danger ? Theme.bad : active ? Theme.accent : Theme.text;
            font-size: Theme.small;
            font-family: Theme.ui-font;
            font-weight: primary ? 600 : 500;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        if root.icon != "": Text { text: root.icon; color: primary ? #1a1200 : Theme.muted; font-size: 9px; font-family: Theme.icons; vertical-alignment: center; }
    }
    ta := TipArea { tip: root.tip; enabled: root.enabled; clicked => { root.clicked(); } }
}

component ChipItem inherits Rectangle {
    in property <Chip> chip;
    in property <bool> active;
    callback picked();
    height: 24px;
    width: t.preferred-width + n.preferred-width + (chip.count != "" ? 26px : 20px);
    border-radius: 12px;
    background: active ? Theme.chip-on : ct.has-hover ? Theme.control-hover : Theme.chip;
    border-width: 1px;
    border-color: active ? Theme.accent.with-alpha(0.45) : Theme.control-line;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        t := Text { text: chip.label; color: active ? Theme.accent : Theme.muted; font-size: Theme.small; font-weight: 500; font-family: Theme.ui-font; vertical-alignment: center; }
        n := Text { text: chip.count; color: active ? Theme.accent.with-alpha(0.8) : Theme.dim; font-size: 11px; font-family: Theme.ui-font; vertical-alignment: center; visible: chip.count != ""; width: chip.count != "" ? self.preferred-width : 0px; }
    }
    ct := TipArea { tip: chip.tip; clicked => { root.picked(); } }
}

export component ChipBar inherits Rectangle {
    in property <[Chip]> chips;
    in property <[[Chip]]> more;
    in property <string> current;
    callback picked(string);
    height: chips.length == 0 ? 0px : 38px + more.length * 30px;
    visible: chips.length > 0;
    VerticalLayout {
        padding-left: 12px;
        padding-top: 6px;
        spacing: 6px;
        alignment: start;
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for c in root.chips: ChipItem { chip: c; active: c.id == root.current; picked => { root.picked(c.id); } }
        }
        for row in root.more: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for c in row: ChipItem { chip: c; active: c.id == root.current; picked => { root.picked(c.id); } }
        }
    }
}

export component Field inherits Rectangle {
    in property <string> placeholder;
    in property <string> icon;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <bool> secret;
    in property <length> font-size: Theme.font;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);
    public function focus-it() { input.focus(); }
    public function select-all() { input.select-all(); }
    height: 30px;
    border-radius: Theme.radius;
    background: input.has-focus ? #0a0c10 : Theme.bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.sel-edge : Theme.control-line;
    opacity: enabled ? 1 : 0.5;
    clip: true;
    animate border-color { duration: 120ms; }
    HorizontalLayout {
        padding-left: root.icon != "" ? 10px : 10px;
        padding-right: 6px;
        spacing: 7px;
        if root.icon != "": Rectangle {
            width: 14px;
            Text { text: root.icon; color: input.has-focus ? Theme.muted : Theme.dim; font-size: 12px; font-family: Theme.icons; vertical-alignment: center; horizontal-alignment: center; width: parent.width; height: parent.height; }
            TipArea { tip: root.tip; }
        }
        Rectangle {
            clip: true;
            min-width: 0;
            horizontal-stretch: 1;
            input := TextInput {
                width: parent.width;
                height: parent.height;
                color: Theme.text;
                font-size: root.font-size;
                font-family: Theme.ui-font;
                single-line: true;
                input-type: root.secret ? InputType.password : InputType.text;
                vertical-alignment: center;
                enabled: root.enabled;
                selection-background-color: Theme.sel-edge.with-alpha(0.55);
                selection-foreground-color: Theme.text;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            Text {
                text: root.placeholder;
                color: Theme.dim;
                font-size: root.font-size;
                font-family: Theme.ui-font;
                vertical-alignment: center;
                height: parent.height;
                width: parent.width;
                overflow: elide;
                visible: input.text == "";
            }
        }
        Rectangle {
            width: input.text != "" ? 18px : 0px;
            visible: input.text != "";
            Text { text: "\u{E711}"; color: cta.has-hover ? Theme.text : Theme.dim; font-size: 10px; font-family: Theme.icons; vertical-alignment: center; horizontal-alignment: center; width: parent.width; height: parent.height; }
            cta := TouchArea { clicked => { input.text = ""; root.edited(""); input.focus(); } }
        }
        @children
    }
}

export component FilterBox inherits Field {
    icon: "\u{E71C}";
    height: 28px;
    width: 220px;
}

export component Toggle inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 26px;
    width: t.preferred-width + 32px;
    Rectangle {
        x: 0;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        background: root.checked ? Theme.accent : Theme.control;
        border-width: 1px;
        border-color: root.checked ? Theme.accent : Theme.control-line;
        animate background { duration: 120ms; }
        Text { text: "\u{E73E}"; color: #1a1200; font-size: 10px; font-family: Theme.icons; vertical-alignment: center; horizontal-alignment: center; visible: root.checked; width: parent.width; height: parent.height; }
    }
    t := Text { x: 24px; text: root.text; color: Theme.text; font-size: Theme.small; font-family: Theme.ui-font; vertical-alignment: center; height: parent.height; }
    TipArea { tip: root.tip; clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

export component LoadBar inherits Rectangle {
    in property <bool> on;
    height: on ? 2px : 0px;
    visible: on;
    background: Theme.line-soft;
    Rectangle {
        width: 30%;
        height: 100%;
        background: Theme.accent;
        x: root.on ? root.width - self.width : 0px;
        animate x { duration: 900ms; iteration-count: -1; easing: ease-in-out; }
    }
}

export component EmptyState inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> sub;
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding: 30px;
        Text { text: root.icon; color: Theme.dim; font-size: 28px; font-family: Theme.icons; horizontal-alignment: center; visible: root.icon != ""; }
        Text { text: root.text; color: Theme.muted; font-size: Theme.font; horizontal-alignment: center; wrap: word-wrap; }
        Text { text: root.sub; color: Theme.dim; font-size: Theme.small; horizontal-alignment: center; wrap: word-wrap; visible: root.sub != ""; }
    }
}

export component BadgeView inherits Rectangle {
    in property <Badge> badge;
    property <color> fg: badge.kind == 1 ? Theme.blue : badge.kind == 2 ? Theme.warn : badge.kind == 3 ? Theme.muted : badge.kind == 4 ? Theme.bad : badge.kind == 5 ? Theme.good : badge.kind == 6 ? Theme.warn : badge.kind == 7 ? Theme.bad : badge.kind == 8 ? Theme.accent : badge.kind == 9 ? Theme.blue : badge.kind == 10 ? Theme.good : Theme.muted;
    height: 18px;
    width: t.preferred-width + 12px;
    border-radius: 5px;
    background: fg.with-alpha(0.12);
    t := Text { text: badge.text; color: fg; font-size: 10.5px; font-weight: 500; font-family: Theme.ui-font; vertical-alignment: center; horizontal-alignment: center; }
    TipArea { tip: badge.tip; enabled: badge.tip != ""; }
}

export component PillView inherits Rectangle {
    in property <Pill> pill;
    callback clicked(string);
    property <color> fg: pill.ok ? Theme.good : Theme.warn;
    height: 20px;
    width: t.preferred-width + 22px;
    border-radius: 10px;
    background: fg.with-alpha(pta.has-hover && pill.clickable ? 0.26 : 0.12);
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 8px;
        spacing: 6px;
        Rectangle { width: 6px; height: 6px; y: (parent.height - 6px) / 2; border-radius: 3px; background: fg; }
        t := Text { text: pill.text; color: fg; font-size: 11px; font-weight: 500; font-family: Theme.ui-font; vertical-alignment: center; }
    }
    pta := TipArea { tip: pill.tip; mouse-cursor: pill.clickable ? pointer : default; clicked => { if pill.clickable { root.clicked(pill.id); } } }
}

export component MetricView inherits Rectangle {
    in property <Metric> metric;
    width: max(l.preferred-width, v.preferred-width) + 20px;
    height: 40px;
    border-radius: Theme.radius;
    background: Theme.control;
    VerticalLayout {
        padding: 4px;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 0px;
        l := Text { text: metric.label; color: Theme.dim; font-size: 10.5px; font-family: Theme.ui-font; }
        v := Text { text: metric.value; color: Theme.tone-color(metric.tone); font-size: 14px; font-weight: 600; font-family: Theme.ui-font; }
    }
}

export component BarList inherits Rectangle {
    in property <[BarRow]> rows;
    in property <string> empty-text;
    background: transparent;
    if root.rows.length == 0: Text { text: root.empty-text; color: Theme.dim; font-size: Theme.small; font-family: Theme.ui-font; x: 14px; y: 12px; }
    ScrollView {
        VerticalLayout {
            padding: 10px;
            padding-top: 6px;
            spacing: 3px;
            alignment: start;
            for r in root.rows: Rectangle {
                height: 40px;
                border-radius: 4px;
                background: bta.has-hover ? Theme.hover : transparent;
                bta := TipArea { tip: r.tip; }
                VerticalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    padding-top: 4px;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: r.label; color: Theme.text; font-size: Theme.font; font-family: Theme.ui-font; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: r.value; color: r.tone == 0 ? Theme.text : Theme.tone-color(r.tone); font-size: Theme.font; font-weight: 600; font-family: Theme.ui-font; horizontal-alignment: right; vertical-alignment: center; }
                    }
                    Rectangle {
                        height: 5px;
                        border-radius: 2.5px;
                        background: Theme.line-soft;
                        Rectangle { x: 0; width: parent.width * min(1.0, max(0.0, r.fraction)); height: parent.height; border-radius: 2.5px; background: r.tone == 4 ? Theme.bad : r.tone == 3 ? Theme.warn : Theme.blue; animate width { duration: 250ms; } }
                    }
                    Text { text: r.sub; color: Theme.dim; font-size: 10.5px; font-family: Theme.ui-font; overflow: elide; visible: r.sub != ""; }
                }
            }
        }
    }
}

export component SegButton inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <bool> active;
    in property <bool> first;
    in property <bool> last;
    callback clicked();
    height: 24px;
    width: t.preferred-width + 22px;
    background: active ? Theme.control-hover : ta.has-hover ? Theme.control : transparent;
    border-radius: 6px;
    animate background { duration: 120ms; }
    t := Text { text: root.text; color: active ? Theme.text : Theme.muted; font-size: Theme.small; font-weight: 500; font-family: Theme.ui-font; vertical-alignment: center; horizontal-alignment: center; }
    ta := TipArea { tip: root.tip; clicked => { root.clicked(); } }
}

export component SegGroup inherits Rectangle {
    height: 28px;
    width: lay.preferred-width;
    border-radius: Theme.radius;
    background: Theme.bg;
    border-width: 1px;
    border-color: Theme.control-line;
    lay := HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        @children
    }
}

export component RailButton inherits Rectangle {
    in property <string> text;
    in property <string> glyph;
    in property <string> tip;
    in property <bool> active;
    in property <color> tint: Theme.blue;
    in property <length> h: 38px;
    callback clicked();
    property <length> box: min(26px, h - 6px);
    height: h;
    border-radius: Theme.radius;
    background: active ? Theme.control-hover : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }
    Rectangle { x: -8px; y: (parent.height - box) / 2 + 2px; width: 3px; height: box - 4px; background: active ? Theme.accent : transparent; border-radius: 2px; }
    HorizontalLayout {
        padding-left: 8px;
        spacing: 10px;
        Rectangle {
            width: root.box;
            height: root.box;
            y: (parent.height - root.box) / 2;
            border-radius: root.box > 22px ? 7px : 5px;
            background: active ? root.tint.with-alpha(0.22) : root.tint.with-alpha(0.10);
            animate background { duration: 120ms; }
            Text { text: root.glyph; color: active ? root.tint : root.tint.with-alpha(0.75); font-size: root.box > 22px ? 13px : 11px; font-family: Theme.icons; width: parent.width; height: parent.height; vertical-alignment: center; horizontal-alignment: center; }
        }
        Text { text: root.text; color: active ? Theme.text : Theme.muted; font-size: Theme.font; font-weight: active ? 600 : 400; font-family: Theme.ui-font; vertical-alignment: center; }
    }
    ta := TipArea { tip: root.tip; clicked => { root.clicked(); } }
}

export component RailSub inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <bool> active;
    in property <length> h: 28px;
    callback clicked();
    height: h;
    border-radius: Theme.radius;
    background: active ? Theme.control-hover : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 22px;
        spacing: 8px;
        Rectangle { width: 6px; height: 6px; y: (parent.height - 6px) / 2; border-radius: 3px; background: active ? Theme.accent : Theme.dim; }
        Text { text: root.text; color: active ? Theme.text : Theme.muted; font-size: Theme.small; font-weight: active ? 600 : 400; font-family: Theme.ui-font; vertical-alignment: center; overflow: elide; }
    }
    ta := TipArea { tip: root.tip; clicked => { root.clicked(); } }
}

export component RailLabel inherits Rectangle {
    in property <string> text;
    height: 26px;
    Text { x: 10px; y: parent.height - 16px; text: root.text; color: Theme.dim; font-size: 10.5px; font-weight: 600; letter-spacing: 0.8px; font-family: Theme.ui-font; }
}

export component SectionTitle inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    height: 30px;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        padding-top: 10px;
        Text { text: root.text; color: Theme.muted; font-size: 11px; font-weight: 700; letter-spacing: 0.6px; font-family: Theme.ui-font; vertical-alignment: center; }
        Text { text: root.hint; color: Theme.dim; font-size: 11px; font-family: Theme.ui-font; vertical-alignment: center; visible: root.hint != ""; }
    }
}

export component Card inherits Rectangle {
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: Theme.radius-lg;
    clip: true;
    @children
}
