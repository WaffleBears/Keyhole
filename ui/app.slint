import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme, Tips } from "theme.slint";
import { Ui } from "state.slint";
import { Cell, Row, Col, Chip, Badge, MenuEntry, DocItem, BoardRow, BarRow, Metric, Pill, StatusPart, Toast, FormField, TabInfo, ShortcutRow } from "types.slint";
import { TipArea, ToolButton, ChipButton, ChipBar, FilterBox, Field, Toggle, LoadBar, EmptyState, BadgeView, PillView, MetricView, SegButton, SegGroup, RailButton, RailSub, RailLabel, SectionTitle, Card, BarList } from "widgets.slint";
import { Table } from "table.slint";
import { Board, Doc } from "panels.slint";
import { AreaChart, Timeline } from "charts.slint";
import { ContextMenu, Dialog, ShortcutsOverlay } from "dialogs.slint";

export { Ui, Tips, Cell, Row, Col, Chip, Badge, MenuEntry, DocItem, BoardRow, Metric, Pill, StatusPart, Toast, FormField, TabInfo, ShortcutRow }

component PaneHead inherits Rectangle {
    in property <string> title;
    in property <string> count;
    in property <string> hint;
    height: 44px;
    background: Theme.head;
    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 10px;
        Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; font-family: Theme.ui-font; vertical-alignment: center; }
        Text { text: root.count; color: Theme.dim; font-size: Theme.small; font-family: Theme.ui-font; vertical-alignment: center; visible: root.count != ""; overflow: elide; }
        Text { text: root.hint; color: Theme.dim; font-size: 11px; font-family: Theme.ui-font; vertical-alignment: center; visible: root.hint != ""; overflow: elide; }
        Rectangle { horizontal-stretch: 1; }
        @children
    }
}

component ProcessesView inherits Rectangle {
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Card {
            height: max(120px, min(Ui.tree-height, Ui.win-height - 330px));
            VerticalLayout {
                PaneHead {
                    title: "Processes";
                    count: Ui.tree-count;
                    FilterBox {
                        placeholder: "Filter by name, PID, path";
                        tip: "Show only processes whose name, PID, path or command line contains this text. Parents of matches stay, dimmed. Prefixes: user:name  pid:1234  session:1";
                        text <=> Ui.tree-filter;
                        edited(t) => { Ui.tree-filter-edited(t); }
                        y: (parent.height - self.height) / 2;
                    }
                    SegGroup {
                        y: (parent.height - self.height) / 2;
                        SegButton { text: "Tree"; active: !Ui.tree-flat; tip: "Show processes as a parent → child tree"; clicked => { Ui.tree-flat-changed(false); } }
                        SegButton { text: "List"; active: Ui.tree-flat; tip: "Show a flat list you can sort fully by any column"; clicked => { Ui.tree-flat-changed(true); } }
                    }
                    ChipButton { text: "Collapse all"; tip: "Collapse every branch"; y: (parent.height - self.height) / 2; clicked => { Ui.collapse-all(); } }
                    ChipButton { text: "Expand all"; tip: "Expand every branch"; y: (parent.height - self.height) / 2; clicked => { Ui.expand-all(); } }
                }
                Rectangle {
                    tree := Table {
                        cols: Ui.tree-cols;
                        rows: Ui.tree-rows;
                        fixed-total: Ui.tree-fixed;
                        sort-key: Ui.tree-sort;
                        sort-desc: Ui.tree-desc;
                        tree-mode: true;
                        scroll-index: Ui.tree-scroll-index;
                        scroll-seq: Ui.tree-scroll-seq;
                        sort(k) => { Ui.tree-sort-clicked(k); }
                        resize(i, w) => { Ui.tree-resize(i, w); }
                        resized-done => { Ui.tree-resized-done(); }
                        clicked(i) => { Ui.tree-clicked(i); }
                        double-clicked(i) => { Ui.tree-double(i); }
                        right-clicked(i, x, y) => { Ui.tree-right(i, x, y); }
                        twisty-clicked(i) => { Ui.tree-twisty(i); }
                        header-right-clicked(x, y) => { Ui.tree-header-right(x, y); }
                    }
                    if Ui.tree-rows.length == 0: EmptyState { y: 30px; height: parent.height - 30px; icon: "\u{E721}"; text: Ui.tree-empty-text; sub: Ui.tree-empty-sub; }
                }
            }
        }
        Rectangle {
            height: 6px;
            Rectangle { x: (parent.width - 60px) / 2; y: 2px; width: 60px; height: 3px; border-radius: 2px; background: sp.has-hover || sp.pressed ? Theme.accent : Theme.line; }
            sp := TouchArea {
                mouse-cursor: row-resize;
                property <length> start-h;
                pointer-event(e) => { if e.kind == PointerEventKind.down { self.start-h = Ui.tree-height; } }
                moved => { Ui.tree-height = max(120px, min(Ui.win-height - 330px, Ui.tree-height + self.mouse-y - self.pressed-y)); }
            }
        }
        Card {
            VerticalLayout {
                Rectangle {
                    height: 76px;
                    background: Theme.head;
                    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 12px;
                        spacing: 14px;
                        Rectangle {
                            width: 40px;
                            height: 40px;
                            y: (parent.height - 40px) / 2;
                            border-radius: Theme.radius;
                            background: Theme.control;
                            if Ui.sel-has-icon: Image { source: Ui.sel-icon; width: 26px; height: 26px; x: 7px; y: 7px; image-fit: contain; }
                            if !Ui.sel-has-icon: Text { text: "\u{E8FD}"; color: Theme.dim; font-size: 14px; font-family: Theme.icons; width: parent.width; height: parent.height; vertical-alignment: center; horizontal-alignment: center; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: Ui.sel-name; color: Theme.text; font-size: 15px; font-weight: 600; font-family: Theme.ui-font; overflow: elide; vertical-alignment: center; min-width: min(self.preferred-width, 120px); }
                                for b in Ui.sel-badges: BadgeView { badge: b; y: (parent.height - self.height) / 2; }
                            }
                            Text { text: Ui.sel-sub; color: Theme.dim; font-size: Theme.small; font-family: Theme.ui-font; overflow: elide; }
                        }
                        if Ui.sel-visible: HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            if Ui.win-width > 1250px: Rectangle {
                                width: 150px;
                                height: 40px;
                                y: (parent.height - 40px) / 2;
                                background: Theme.control;
                                border-radius: Theme.radius;
                                clip: true;
                                Text { x: 10px; y: 4px; text: "CPU history"; color: Theme.dim; font-size: 10.5px; font-family: Theme.ui-font; }
                                AreaChart { x: 8px; y: 17px; width: parent.width - 16px; height: 19px; line-path: Ui.cpu-path; fill-path: Ui.cpu-fill; line-color: Theme.tone-color(Ui.cpu-tone == 0 ? 5 : Ui.cpu-tone); line-width: 1.3px; fill-alpha: 0.22; }
                                TipArea { tip: "CPU usage of this process over the last ~40 seconds"; }
                            }
                            if Ui.win-width > 940px: MetricView { metric: { label: "CPU", value: Ui.cpu-text, tone: Ui.cpu-tone }; y: (parent.height - self.height) / 2; }
                            if Ui.win-width > 1000px: MetricView { metric: { label: "Private", value: Ui.priv-text, tone: 0 }; y: (parent.height - self.height) / 2; }
                            if Ui.win-width > 1000px: MetricView { metric: { label: "Working set", value: Ui.ws-text, tone: 0 }; y: (parent.height - self.height) / 2; }
                            if Ui.win-width > 1120px: MetricView { metric: { label: "Handles", value: Ui.handles-text, tone: 0 }; y: (parent.height - self.height) / 2; }
                            if Ui.win-width > 1120px: MetricView { metric: { label: "Threads", value: Ui.threads-text, tone: 0 }; y: (parent.height - self.height) / 2; }
                            Rectangle { width: 6px; }
                            if Ui.win-width > 940px: ChipButton { text: Ui.suspend-label; tip: Ui.suspend-tip; y: (parent.height - self.height) / 2; clicked => { Ui.dh-suspend(); } }
                            ChipButton { text: "Terminate"; danger: true; tip: "End this process immediately (unsaved work is lost)"; y: (parent.height - self.height) / 2; clicked => { Ui.dh-kill(); } }
                            more := ChipButton { text: "More"; icon: "\u{E70D}"; tip: "More actions: copy, show in Explorer, suspend, minidump, restart, terminate whole tree"; y: (parent.height - self.height) / 2; clicked => { Ui.dh-more(self.absolute-position.x + self.width - 300px, self.absolute-position.y + self.height + 4px); } }
                        }
                    }
                }
                Rectangle {
                    height: 40px;
                    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 0px;
                            alignment: start;
                            for t in Ui.tabs: Rectangle {
                                width: tt.preferred-width + 24px;
                                Rectangle { y: parent.height - 2px; height: 2px; width: parent.width - 16px; x: 8px; border-radius: 1px; background: t.id == Ui.tab ? Theme.accent : transparent; }
                                tt := Text { text: t.label; color: t.id == Ui.tab ? Theme.text : tta.has-hover ? Theme.text : Theme.muted; font-size: Theme.font; font-weight: t.id == Ui.tab ? 600 : 400; font-family: Theme.ui-font; vertical-alignment: center; horizontal-alignment: center; }
                                tta := TipArea { tip: t.tip; clicked => { Ui.tab-clicked(t.id); } }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if Ui.sel-visible && Ui.show-detail-filter: FilterBox {
                            placeholder: "Filter";
                            tip: "Show only rows in this tab that contain this text";
                            width: 180px;
                            text <=> Ui.detail-filter;
                            edited(t) => { Ui.detail-filter-edited(t); }
                            y: (parent.height - self.height) / 2;
                        }
                        if Ui.sel-visible && Ui.show-named: Toggle { text: "Named only"; tip: "Hide unnamed objects (most events, mutexes and semaphores) and show only things with a path or name"; checked <=> Ui.named-only; toggled(v) => { Ui.named-toggled(v); } y: (parent.height - self.height) / 2; }
                        if Ui.sel-visible && Ui.show-dns: Toggle { text: "Resolve names"; tip: "Look up host names for remote addresses by reverse DNS. Lookups run in the background and fill in over a few seconds."; checked <=> Ui.resolve-dns; toggled(v) => { Ui.dns-toggled(v); } y: (parent.height - self.height) / 2; }
                    }
                }
                HorizontalLayout {
                    ChipBar { chips: Ui.type-chips; more: Ui.type-chips-more; current: Ui.type-chip; picked(id) => { Ui.type-chip-picked(id); } }
                    if Ui.chip-note != "": Text { text: Ui.chip-note; color: Theme.warn; font-size: 11px; font-family: Theme.ui-font; vertical-alignment: center; }
                }
                LoadBar { on: Ui.detail-loading; }
                Rectangle {
                    if !Ui.detail-is-doc: Table {
                        cols: Ui.detail-cols;
                        rows: Ui.detail-rows;
                        fixed-total: Ui.detail-fixed;
                        sort-key: Ui.detail-sort;
                        sort-desc: Ui.detail-desc;
                        sort(k) => { Ui.detail-sort-clicked(k); }
                        resize(i, w) => { Ui.detail-resize(i, w); }
                        resized-done => { Ui.detail-resized-done(); }
                        clicked(i) => { Ui.detail-clicked(i); }
                        double-clicked(i) => { Ui.detail-double(i); }
                        right-clicked(i, x, y) => { Ui.detail-right(i, x, y); }
                    }
                    if !Ui.detail-is-doc && Ui.detail-rows.length == 0 && !Ui.detail-loading: EmptyState { y: 30px; height: parent.height - 30px; icon: Ui.detail-empty-icon; text: Ui.detail-empty-text; sub: Ui.detail-empty-sub; }
                    if Ui.detail-is-doc: Doc {
                        items: Ui.detail-doc;
                        right-clicked(i, x, y) => { Ui.doc-right("detail", i, x, y); }
                        jump(pid) => { Ui.doc-jump(pid); }
                        button(id) => { Ui.doc-button("detail", id); }
                    }
                }
            }
        }
    }
}

component ListPane inherits Card {
    property <bool> compact: Ui.win-width < 1250px || (Ui.list-segments.length > 0 && Ui.list-buttons.length > 1 && Ui.win-width < 1500px);
    VerticalLayout {
        PaneHead {
            title: Ui.list-title;
            count: Ui.list-count;
            FilterBox {
                placeholder: Ui.list-filter-placeholder;
                tip: Ui.list-filter-tip;
                width: root.compact ? 200px : 240px;
                text <=> Ui.list-filter;
                edited(t) => { Ui.list-filter-edited(t); }
                y: (parent.height - self.height) / 2;
            }
            if !root.compact && Ui.list-segments.length > 0: SegGroup {
                y: (parent.height - self.height) / 2;
                for sg in Ui.list-segments: SegButton { text: sg.label; tip: sg.tip; active: sg.id == Ui.list-segment; clicked => { Ui.list-segment-picked(sg.id); } }
            }
            if !root.compact && Ui.list-toggle-visible: Toggle { text: Ui.list-toggle-label; tip: Ui.list-toggle-tip; checked <=> Ui.list-toggle-checked; toggled(v) => { Ui.list-toggle(v); } y: (parent.height - self.height) / 2; }
            if !root.compact: HorizontalLayout {
                spacing: 10px;
                for b in Ui.list-buttons: ChipButton { text: b.label; tip: b.tip; primary: b.id == "add" || b.id == "installall"; y: (parent.height - self.height) / 2; clicked => { Ui.list-button(b.id); } }
            }
        }
        if root.compact: Rectangle {
            height: 40px;
            background: Theme.head;
            Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                spacing: 10px;
                if Ui.list-segments.length > 0: SegGroup {
                    y: (parent.height - self.height) / 2;
                    for sg in Ui.list-segments: SegButton { text: sg.label; tip: sg.tip; active: sg.id == Ui.list-segment; clicked => { Ui.list-segment-picked(sg.id); } }
                }
                if Ui.list-toggle-visible: Toggle { text: Ui.list-toggle-label; tip: Ui.list-toggle-tip; checked <=> Ui.list-toggle-checked; toggled(v) => { Ui.list-toggle(v); } y: (parent.height - self.height) / 2; }
                Rectangle { horizontal-stretch: 1; }
                for b in Ui.list-buttons: ChipButton { text: b.label; tip: b.tip; primary: b.id == "add" || b.id == "installall"; y: (parent.height - self.height) / 2; clicked => { Ui.list-button(b.id); } }
            }
        }
        ChipBar { chips: Ui.list-chips; more: Ui.list-chips-more; current: Ui.list-chip; picked(id) => { Ui.list-chip-picked(id); } }
        LoadBar { on: Ui.list-loading; }
        Rectangle {
            Table {
                cols: Ui.list-cols;
                rows: Ui.list-rows;
                fixed-total: Ui.list-fixed;
                sort-key: Ui.list-sort;
                sort-desc: Ui.list-desc;
                scroll-index: Ui.list-scroll-index;
                scroll-seq: Ui.list-scroll-seq;
                sort(k) => { Ui.list-sort-clicked(k); }
                resize(i, w) => { Ui.list-resize(i, w); }
                resized-done => { Ui.list-resized-done(); }
                multi: true;
                clicked(i) => { Ui.list-clicked(i); }
                multi-clicked(i, c, s) => { Ui.list-multi-clicked(i, c, s); }
                double-clicked(i) => { Ui.list-double(i); }
                right-clicked(i, x, y) => { Ui.list-right(i, x, y); }
            }
            if Ui.list-rows.length == 0 && !Ui.list-loading: EmptyState { y: 30px; height: parent.height - 30px; icon: Ui.list-empty-icon; text: Ui.list-empty-text; sub: Ui.list-empty-sub; }
        }
    }
}

component ActivityBar inherits Rectangle {
    height: 56px;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 12px;
        if Ui.show-layer: SegGroup {
            y: (parent.height - self.height) / 2;
            SegButton { text: "File level"; active: Ui.layer == "file"; tip: "File level I/O: everything apps asked for, including reads served from cache, so usually more than disk level"; clicked => { Ui.layer-changed("file"); } }
            SegButton { text: "Disk level"; active: Ui.layer == "disk"; tip: "Disk level I/O: only transfers that reached a physical disk, per disk with response times"; clicked => { Ui.layer-changed("disk"); } }
        }
        for m in Ui.bar-metrics: MetricView { metric: m; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: Ui.bar-text; color: Theme.tone-color(Ui.bar-text-tone); font-size: Theme.small; font-weight: 500; font-family: Theme.ui-font; overflow: elide; visible: Ui.bar-text != ""; }
            Text { text: Ui.bar-text2; color: Theme.dim; font-size: Theme.small; font-family: Theme.ui-font; overflow: elide; visible: Ui.bar-text2 != ""; }
        }
        if Ui.bar-link != "": ChipButton { text: Ui.bar-link; primary: true; y: (parent.height - self.height) / 2; clicked => { Ui.bar-link-clicked(); } }
    }
}

component ActivityView inherits Rectangle {
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        ActivityBar { }
        if Ui.show-timeline: Timeline { read-path: Ui.tl-read-path; read-fill: Ui.tl-read-fill; write-path: Ui.tl-write-path; write-fill: Ui.tl-write-fill; scale-text: Ui.tl-scale; read-label: Ui.tl-read-label; write-label: Ui.tl-write-label; tip: Ui.tl-tip; }
        HorizontalLayout {
            spacing: 8px;
            if Ui.board2-visible: Card {
                VerticalLayout {
                    PaneHead { title: Ui.board-title; hint: Ui.board-hint; }
                    Board {
                        rows: Ui.board-rows;
                        empty-text: Ui.board-empty;
                        empty-sub: Ui.board-empty-sub;
                        read-label: Ui.board-read-label;
                        write-label: Ui.board-write-label;
                        clicked(i) => { Ui.board-clicked("files", i); }
                        double-clicked(i) => { Ui.board-double("files", i); }
                        right-clicked(i, x, y) => { Ui.board-right("files", i, x, y); }
                    }
                }
            }
            Card {
                VerticalLayout {
                    PaneHead { title: Ui.board2-title; hint: Ui.board2-hint; }
                    Board {
                        rows: Ui.board2-rows;
                        empty-text: Ui.board2-empty;
                        empty-sub: Ui.board2-empty-sub;
                        show-spark: Ui.board-spark;
                        total-label: Ui.board-total-label;
                        read-label: Ui.board-read-label;
                        write-label: Ui.board-write-label;
                        clicked(i) => { Ui.board-clicked("procs", i); }
                        double-clicked(i) => { Ui.board-double("procs", i); }
                        right-clicked(i, x, y) => { Ui.board-right("procs", i, x, y); }
                    }
                }
            }
        }
    }
}

component ResourcesView inherits Rectangle {
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                spacing: 12px;
                alignment: start;
                for m in Ui.res-metrics: MetricView { metric: m; y: (parent.height - self.height) / 2; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Timeline { read-path: Ui.res-cpu-path; read-fill: Ui.res-cpu-fill; write-path: Ui.res-kernel-path; write-fill: Ui.res-kernel-fill; scale-text: Ui.res-cpu-scale; read-label: "cpu"; write-label: "kernel"; tip: "Total CPU (blue) and the share spent in the kernel (amber) over the last 90 seconds"; }
            Timeline { read-path: Ui.res-mem-path; read-fill: Ui.res-mem-fill; write-path: Ui.res-commit-path; write-fill: Ui.res-commit-fill; scale-text: Ui.res-mem-scale; read-label: "in use"; write-label: "commit"; tip: "Physical memory in use (blue) and commit charge against its limit (amber) over the last 90 seconds"; }
        }
        HorizontalLayout {
            spacing: 8px;
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    PaneHead { title: "Cores"; hint: "per logical processor, with the kernel share underneath"; }
                    BarList { rows: Ui.res-cores; empty-text: "Sampling..."; }
                }
            }
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    PaneHead { title: "Memory"; hint: "where the RAM went, each as a share of physical memory"; }
                    BarList { rows: Ui.res-mem-doc; empty-text: "Sampling..."; }
                }
            }
            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    PaneHead { title: "Disks and network"; hint: Ui.res-devices-hint; }
                    BarList { rows: Ui.res-devices; empty-text: "Sampling..."; }
                }
            }
        }
    }
}

component NetworkView inherits Rectangle {
    VerticalLayout {
        padding: 10px;
        spacing: 8px;
        ActivityBar { }
        if Ui.show-timeline: Timeline { read-path: Ui.tl-read-path; read-fill: Ui.tl-read-fill; write-path: Ui.tl-write-path; write-fill: Ui.tl-write-fill; scale-text: Ui.tl-scale; read-label: "received"; write-label: "sent"; tip: Ui.tl-tip; }
        HorizontalLayout {
            spacing: 8px;
            ListPane { horizontal-stretch: 3; }
            Card {
                horizontal-stretch: 1;
                min-width: 330px;
                VerticalLayout {
                    PaneHead { title: Ui.board2-title; hint: Ui.board2-hint; }
                    Board {
                        rows: Ui.board2-rows;
                        empty-text: Ui.board2-empty;
                        empty-sub: Ui.board2-empty-sub;
                        show-spark: Ui.board-spark;
                        show-io: Ui.board-spark;
                        show-who: false;
                        read-label: Ui.board-read-label;
                        write-label: Ui.board-write-label;
                        total-label: Ui.board-total-label;
                        clicked(i) => { Ui.board-clicked("procs", i); }
                        double-clicked(i) => { Ui.board-double("procs", i); }
                        right-clicked(i, x, y) => { Ui.board-right("procs", i, x, y); }
                    }
                }
            }
        }
    }
}

component DumpPanel inherits Rectangle {
    background: #000000b4;
    TouchArea { clicked => { Ui.dump-close(); } }
    Card {
        x: 40px;
        y: 60px;
        width: root.width - 80px;
        height: root.height - 100px;
        background: Theme.panel;
        drop-shadow-blur: 40px;
        drop-shadow-color: #000000b0;
        TouchArea { }
        VerticalLayout {
            Rectangle {
                height: 64px;
                background: Theme.head;
                Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text { text: Ui.dump-title; color: Theme.text; font-size: 16px; font-weight: 600; font-family: Theme.ui-font; overflow: elide; }
                            Text { text: Ui.dump-kind; color: Theme.dim; font-size: Theme.small; font-family: Theme.ui-font; vertical-alignment: center; }
                        }
                        Text { text: Ui.dump-verdict; color: Ui.dump-verdict-tone == 0 ? Theme.muted : Theme.tone-color(Ui.dump-verdict-tone); font-size: Theme.font; font-weight: 600; font-family: Theme.ui-font; overflow: elide; }
                    }
                    ChipButton { text: "Copy report"; tip: "Copy the whole analysis as text, ready for a ticket or an email"; y: (parent.height - self.height) / 2; clicked => { Ui.dump-copy(); } }
                    ChipButton { text: "Save report…"; tip: "Save the analysis as a text file next to your other notes"; y: (parent.height - self.height) / 2; clicked => { Ui.dump-save(); } }
                    ChipButton { text: "Close"; tip: "Close this panel (Esc)"; y: (parent.height - self.height) / 2; clicked => { Ui.dump-close(); } }
                }
            }
            LoadBar { on: Ui.dump-loading; }
            Rectangle {
                Doc { items: Ui.dump-doc; right-clicked(i, x, y) => { Ui.dump-doc-right(i, x, y); } }
                if Ui.dump-doc.length == 0 && !Ui.dump-loading: EmptyState { y: 30px; height: parent.height - 30px; icon: "\u{EA39}"; text: "Nothing to show"; sub: ""; }
                if Ui.dump-loading: EmptyState { y: 30px; height: parent.height - 30px; icon: "\u{EA39}"; text: "Reading the dump and walking the stack..."; sub: "Modules are matched against the files on this machine, so no symbols or internet access are needed."; }
            }
        }
    }
}

component FinderPanel inherits Rectangle {
    background: #000000b4;
    TouchArea { clicked => { Ui.finder-close(); } }
    Card {
        x: 40px;
        y: 60px;
        width: root.width - 80px;
        height: root.height - 100px;
        background: Theme.panel;
        drop-shadow-blur: 40px;
        drop-shadow-color: #000000b0;
        TouchArea { }
        VerticalLayout {
            Rectangle {
                height: 64px;
                background: Theme.head;
                Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: "Who has this open?"; color: Theme.text; font-size: 16px; font-weight: 600; font-family: Theme.ui-font; }
                        Text { text: Ui.finder-query; color: Theme.muted; font-size: Theme.small; font-family: Theme.mono; overflow: elide; }
                    }
                    Toggle { text: "Match everything under this folder"; tip: "Treat the search text as a folder and match anything open beneath it: why can't I delete this folder or eject this drive"; checked <=> Ui.finder-subtree; toggled(v) => { Ui.finder-subtree-changed(v); } y: (parent.height - self.height) / 2; }
                    fx := ChipButton { text: "Export"; tip: "Save these results as a CSV file"; y: (parent.height - self.height) / 2; clicked => { Ui.finder-export(self.absolute-position.x + self.width - 330px, self.absolute-position.y + self.height + 4px); } }
                    ChipButton { text: "Rescan"; tip: "Run this search again against the current system state"; y: (parent.height - self.height) / 2; clicked => { Ui.finder-rerun(); } }
                    ChipButton { text: "Close"; tip: "Close this panel (Esc)"; y: (parent.height - self.height) / 2; clicked => { Ui.finder-close(); } }
                }
            }
            ChipBar { chips: Ui.finder-chips; more: Ui.finder-chips-more; current: Ui.finder-chip; picked(id) => { Ui.finder-chip-picked(id); } }
            LoadBar { on: Ui.finder-loading; }
            Rectangle {
                ft := Table {
                    cols: Ui.finder-cols;
                    rows: Ui.finder-rows;
                    fixed-total: Ui.finder-fixed;
                    sort-key: Ui.finder-sort;
                    sort-desc: Ui.finder-desc;
                    scroll-index: Ui.finder-scroll-index;
                    scroll-seq: Ui.finder-scroll-seq;
                    sort(k) => { Ui.finder-sort-clicked(k); }
                    resize(i, w) => { Ui.finder-resize(i, w); }
                    resized-done => { Ui.finder-resized-done(); }
                    clicked(i) => { Ui.finder-clicked(i); }
                    double-clicked(i) => { Ui.finder-double(i); }
                    right-clicked(i, x, y) => { Ui.finder-right(i, x, y); }
                }
                if Ui.finder-rows.length == 0 && !Ui.finder-loading: EmptyState { y: 30px; height: parent.height - 30px; icon: "\u{E721}"; text: "Nothing has that open."; sub: ""; }
            }
            Rectangle {
                height: 34px;
                background: Theme.head;
                Rectangle { y: 0; height: 1px; width: parent.width; background: Theme.line; }
                Text { x: 16px; width: parent.width - 32px; height: parent.height; text: Ui.finder-foot; color: Theme.muted; font-size: Theme.small; font-family: Theme.ui-font; vertical-alignment: center; overflow: elide; }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: Ui.window-title;
    background: Theme.bg;
    preferred-width: 1380px;
    preferred-height: 880px;
    min-width: 860px;
    min-height: 560px;
    icon: @image-url("../assets/keyhole.png");
    default-font-family: Theme.ui-font;
    default-font-size: Theme.font;
    changed width => { Ui.win-width = self.width; Ui.window-resized(); }
    changed height => { Ui.win-height = self.height; }
    init => { Ui.win-width = self.width; Ui.win-height = self.height; }

    keys := FocusScope {
        key-pressed(e) => {
            if Ui.key-pressed(e.text, e.modifiers.control, e.modifiers.shift) { return accept; }
            reject
        }
        VerticalLayout {
            Rectangle {
                height: 52px;
                background: Theme.head;
                Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 9px;
                        width: 138px;
                        Image {
                            source: @image-url("../assets/keyhole-56.png");
                            width: 28px;
                            height: 28px;
                            y: (parent.height - 28px) / 2;
                            image-fit: contain;
                        }
                        Text { text: "Keyhole"; color: Theme.text; font-size: 15px; font-weight: 600; font-family: Theme.ui-font; vertical-alignment: center; }
                    }
                    search := Field {
                        horizontal-stretch: 1;
                        max-width: 760px;
                        height: 34px;
                        y: (parent.height - 34px) / 2;
                        icon: "\u{E721}";
                        placeholder: "What's using this file?  Paste a path or drop a file here, then press Enter";
                        text <=> Ui.search-text;
                        accepted(t) => { Ui.search-submitted(t); }
                        Rectangle {
                            width: kt.preferred-width + 12px;
                            height: 20px;
                            y: (parent.height - 20px) / 2;
                            border-radius: 5px;
                            background: Theme.control;
                            border-width: 1px;
                            border-color: Theme.control-line;
                            visible: !search.has-focus && search.text == "";
                            kt := Text { text: "Ctrl+F"; color: Theme.dim; font-size: 10.5px; font-family: Theme.ui-font; vertical-alignment: center; horizontal-alignment: center; }
                        }
                        ChipButton { text: "Browse…"; icon: "\u{E8E5}"; tip: "Pick a file to find what is holding it open"; y: (parent.height - self.height) / 2; clicked => { Ui.browse-clicked(); } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        if Ui.live-view: ToolButton { text: Ui.pause-label; min-w: 92px; dot: Ui.pause-dot; active: Ui.pause-active; tip: "Freeze the whole view so nothing moves under your cursor (Space)"; y: (parent.height - self.height) / 2; clicked => { Ui.pause-clicked(); } }
                        if Ui.live-view: ComboBox { width: 92px; height: 30px; y: (parent.height - 30px) / 2; model: Ui.rate-options; current-index <=> Ui.rate-index; selected => { Ui.rate-changed(self.current-index); } }
                        ToolButton { text: "\u{E72C}"; icon-only: true; tip: "Refresh everything right now (F5)"; y: (parent.height - self.height) / 2; clicked => { Ui.refresh-clicked(); } }
                        ex := ToolButton { text: "Export"; icon: "\u{E70D}"; tip: "Save the current view, the selected process's tab, or a whole system snapshot"; y: (parent.height - self.height) / 2; clicked => { Ui.export-clicked(self.absolute-position.x + self.width - 330px, self.absolute-position.y + self.height + 4px); } }
                        ToolButton { text: "\u{E897}"; icon-only: true; tip: "Keyboard shortcuts (?)"; y: (parent.height - self.height) / 2; clicked => { Ui.help-clicked(); } }
                    }
                }
            }
            HorizontalLayout {
                rail := Rectangle {
                    width: 172px;
                    background: Theme.rail;
                    property <int> entries: 18;
                    property <int> sections: 3;
                    property <length> label-h: 26px;
                    property <length> item-h: max(26px, min(38px, (self.height - sections * (label-h + 1px) - 14px - entries * 1px) / entries));
                    init => { Ui.rail-height = self.height; }
                    changed height => { Ui.rail-height = self.height; }
                    Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.line; }
                    Flickable {
                        x: 0;
                        y: 0;
                        width: parent.width - 1px;
                        height: parent.height;
                        viewport-height: rail-items.preferred-height;
                        rail-items := VerticalLayout {
                        init => { Ui.rail-content = self.preferred-height; }
                        changed preferred-height => { Ui.rail-content = self.preferred-height; }
                        width: parent.width;
                        padding: 10px;
                        padding-top: 4px;
                        spacing: 1px;
                        alignment: start;
                        RailLabel { height: rail.label-h; text: "LIVE"; }
                        RailButton { h: rail.item-h; text: "Processes"; glyph: "\u{E8FD}"; tint: Theme.accent; active: Ui.mode == "processes"; tip: "The process tree and per process handle inspector"; clicked => { Ui.set-mode("processes"); } }
                        RailButton { h: rail.item-h; text: "Resources"; glyph: "\u{E9D9}"; tint: #4ad3a6; active: Ui.mode == "resources"; tip: "CPU per core, memory in every bucket, physical disks and network interfaces, with 90 second timelines"; clicked => { Ui.set-mode("resources"); } }
                        RailButton { h: rail.item-h; text: "Disk"; glyph: "\u{EDA2}"; tint: #6cc4ff; active: Ui.mode == "activity"; tip: "Live file I/O by file and process, and physical disk throughput and latency"; clicked => { Ui.set-mode("activity"); } }
                        RailButton { h: rail.item-h; text: "Network"; glyph: "\u{E968}"; tint: #8b7cf6; active: Ui.mode == "network"; tip: "Live network connections and per process throughput"; clicked => { Ui.set-mode("network"); } }
                        RailButton { h: rail.item-h; text: "Open files"; glyph: "\u{E8A5}"; tint: #4ad3a6; active: Ui.mode == "files" || Ui.mode == "handles"; tip: "Every open file with who holds it and live activity, and underneath it every handle of every kind"; clicked => { if !(Ui.mode == "files" || Ui.mode == "handles") { Ui.set-mode("files"); } } }
                        if Ui.mode == "files" || Ui.mode == "handles": RailSub { h: rail.item-h - 8px; text: "Files"; active: Ui.mode == "files"; tip: "Every open file, one row per file, with the processes holding it and live read and write activity"; clicked => { Ui.set-mode("files"); } }
                        if Ui.mode == "files" || Ui.mode == "handles": RailSub { h: rail.item-h - 8px; text: "All handles"; active: Ui.mode == "handles"; tip: "Every open file, registry key and object on the system, across all processes"; clicked => { Ui.set-mode("handles"); } }
                        RailButton { h: rail.item-h; text: "Shares"; glyph: "\u{E8CE}"; tint: #4fd1c5; active: Ui.mode == "shares"; tip: "What this server shares over SMB, who is connected and which files they hold open"; clicked => { Ui.set-mode("shares"); } }
                        RailButton { h: rail.item-h; text: "Events"; glyph: "\u{E7BA}"; tint: #f2c94c; active: Ui.mode == "events" || Ui.mode == "crashes"; tip: "Errors and warnings tailed live from the event logs, plus the crashes, hangs and unexpected shutdowns that left a dump or report"; clicked => { if !(Ui.mode == "events" || Ui.mode == "crashes") { Ui.set-mode("events"); } } }
                        if Ui.mode == "events" || Ui.mode == "crashes": RailSub { h: rail.item-h - 8px; text: "Event logs"; active: Ui.mode == "events"; tip: "Errors and warnings from every enabled Windows log, tailed live, with Security on demand"; clicked => { Ui.set-mode("events"); } }
                        if Ui.mode == "events" || Ui.mode == "crashes": RailSub { h: rail.item-h - 8px; text: "Crashes"; active: Ui.mode == "crashes"; tip: "Blue screens, application crashes, hangs and unexpected shutdowns that left a dump, a report or an event"; clicked => { Ui.set-mode("crashes"); } }
                        RailLabel { height: rail.label-h; text: "CONFIGURATION"; }
                        RailButton { h: rail.item-h; text: "Services"; glyph: "\u{E713}"; tint: #7fb6ff; active: Ui.mode == "services"; tip: "Windows services, their state and hosting process"; clicked => { Ui.set-mode("services"); } }
                        RailButton { h: rail.item-h; text: "Autostart"; glyph: "\u{E7E8}"; tint: #f2c94c; active: Ui.mode == "startup" || Ui.mode == "tasks"; tip: "Everything that runs without anyone starting it: Run keys, startup folders and scheduled tasks"; clicked => { if !(Ui.mode == "startup" || Ui.mode == "tasks") { Ui.set-mode("startup"); } } }
                        if Ui.mode == "startup" || Ui.mode == "tasks": RailSub { h: rail.item-h - 8px; text: "Startup entries"; active: Ui.mode == "startup"; tip: "Programs and scripts that run automatically at logon or boot"; clicked => { Ui.set-mode("startup"); } }
                        if Ui.mode == "startup" || Ui.mode == "tasks": RailSub { h: rail.item-h - 8px; text: "Scheduled tasks"; active: Ui.mode == "tasks"; tip: "Scheduled tasks and when they run"; clicked => { Ui.set-mode("tasks"); } }
                        RailButton { h: rail.item-h; text: "Software"; glyph: "\u{E7B8}"; tint: #4fd1c5; active: Ui.mode == "software" || Ui.mode == "drivers" || Ui.mode == "updates"; tip: "What is installed: programs, kernel and file system drivers, and Windows Update history with reboot pending reasons"; clicked => { if !(Ui.mode == "software" || Ui.mode == "drivers" || Ui.mode == "updates") { Ui.set-mode("software"); } } }
                        if Ui.mode == "software" || Ui.mode == "drivers" || Ui.mode == "updates": RailSub { h: rail.item-h - 8px; text: "Programs"; active: Ui.mode == "software"; tip: "Installed programs and updates"; clicked => { Ui.set-mode("software"); } }
                        if Ui.mode == "software" || Ui.mode == "drivers" || Ui.mode == "updates": RailSub { h: rail.item-h - 8px; text: "Drivers"; active: Ui.mode == "drivers"; tip: "Installed kernel and file system drivers, and which are loaded right now"; clicked => { Ui.set-mode("drivers"); } }
                        if Ui.mode == "software" || Ui.mode == "drivers" || Ui.mode == "updates": RailSub { h: rail.item-h - 8px; text: "Updates"; active: Ui.mode == "updates"; tip: "What Windows Update installed and when, whether a reboot is pending and why, and on request what is still pending"; clicked => { Ui.set-mode("updates"); } }
                        RailButton { h: rail.item-h; text: "Firewall"; glyph: "\u{EA18}"; tint: #f26d6d; active: Ui.mode == "firewall"; tip: "Windows Firewall rules and profile state"; clicked => { Ui.set-mode("firewall"); } }
                        RailButton { h: rail.item-h; text: "Net config"; glyph: "\u{E839}"; tint: #7fb6ff; active: Ui.mode == "netconfig"; tip: "Adapters with addresses, gateways, DNS and DHCP, the routing table and the resolver cache"; clicked => { Ui.set-mode("netconfig"); } }
                        RailButton { h: rail.item-h; text: "Certificates"; glyph: "\u{EB95}"; tint: #e8b04a; active: Ui.mode == "certs"; tip: "Machine certificates with expiry, private key, SANs and what HTTPS ports or Remote Desktop use them"; clicked => { Ui.set-mode("certs"); } }
                        RailLabel { height: rail.label-h; text: "MACHINE"; }
                        RailButton { h: rail.item-h; text: "Users"; glyph: "\u{E77B}"; tint: #7fb6ff; active: Ui.mode == "users" || Ui.mode == "sessions"; tip: "Local accounts and groups with domain members expanded, and who is logged on now"; clicked => { if !(Ui.mode == "users" || Ui.mode == "sessions") { Ui.set-mode("users"); } } }
                        if Ui.mode == "users" || Ui.mode == "sessions": RailSub { h: rail.item-h - 8px; text: "Accounts and groups"; active: Ui.mode == "users"; tip: "Local accounts and groups, and who is in Administrators and Remote Desktop Users, domain members included"; clicked => { Ui.set-mode("users"); } }
                        if Ui.mode == "users" || Ui.mode == "sessions": RailSub { h: rail.item-h - 8px; text: "Logon sessions"; active: Ui.mode == "sessions"; tip: "Logon sessions and connected users"; clicked => { Ui.set-mode("sessions"); } }
                        RailButton { h: rail.item-h; text: "System"; glyph: "\u{E946}"; tint: #a3acba; active: Ui.mode == "environment"; tip: "Machine overview: Windows build, hardware, drives, network adapters and environment variables"; clicked => { Ui.set-mode("environment"); } }
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    if Ui.mode == "processes": ProcessesView { }
                    if Ui.mode == "activity": ActivityView { }
                    if Ui.mode == "network": NetworkView { }
                    if Ui.mode == "resources": ResourcesView { }
                    if Ui.mode == "files" || Ui.mode == "handles" || Ui.mode == "services" || Ui.mode == "startup" || Ui.mode == "tasks" || Ui.mode == "drivers" || Ui.mode == "software" || Ui.mode == "firewall" || Ui.mode == "sessions" || Ui.mode == "events" || Ui.mode == "crashes" || Ui.mode == "shares" || Ui.mode == "users" || Ui.mode == "updates" || Ui.mode == "certs" || Ui.mode == "netconfig": Rectangle {
                        VerticalLayout { padding: 10px; ListPane { } }
                    }
                    if Ui.mode == "environment": Rectangle {
                        VerticalLayout {
                            padding: 10px;
                            Card {
                                VerticalLayout {
                                    PaneHead {
                                        title: "System";
                                        FilterBox {
                                            placeholder: "Filter environment variables";
                                            tip: "Show only environment variables whose name, value or scope contains this text";
                                            text <=> Ui.env-filter;
                                            edited(t) => { Ui.env-filter-edited(t); }
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                    Doc {
                                        items: Ui.env-doc;
                                        right-clicked(i, x, y) => { Ui.doc-right("env", i, x, y); }
                                        jump(pid) => { Ui.doc-jump(pid); }
                                        button(id) => { Ui.doc-button("env", id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 28px;
                background: Theme.head;
                Rectangle { y: 0; height: 1px; width: parent.width; background: Theme.line; }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 18px;
                    alignment: start;
                    for p in Ui.status-parts: HorizontalLayout {
                        spacing: 5px;
                        Text { text: p.bold; color: Theme.text; font-size: Theme.small; font-weight: 600; font-family: Theme.ui-font; vertical-alignment: center; visible: p.bold != ""; }
                        Text { text: p.text; color: Theme.dim; font-size: Theme.small; font-family: Theme.ui-font; vertical-alignment: center; }
                        TipArea { tip: p.tip; enabled: p.tip != ""; }
                    }
                    Rectangle { width: 1px; height: 14px; y: 7px; background: Theme.line; }
                    for p in Ui.pills: PillView { pill: p; y: (parent.height - self.height) / 2; clicked(id) => { Ui.pill-clicked(id); } }
                }
            }
        }
    }

    if search.has-focus && search.text == "" && Ui.search-history.length > 0 && !Ui.finder-open: Rectangle {
        x: search.absolute-position.x;
        y: search.absolute-position.y + search.height + 6px;
        width: min(560px, search.width);
        height: hl.preferred-height;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: Theme.radius;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000090;
        hl := VerticalLayout {
            padding: 6px;
            spacing: 1px;
            Text { text: "Recent searches"; color: Theme.dim; font-size: 10.5px; font-weight: 600; letter-spacing: 0.6px; font-family: Theme.ui-font; height: 22px; vertical-alignment: center; x: 8px; }
            for h in Ui.search-history: Rectangle {
                height: 26px;
                border-radius: 6px;
                background: hta.has-hover ? Theme.hover : transparent;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text { text: "\u{E81C}"; color: Theme.dim; font-size: 11px; font-family: Theme.icons; vertical-alignment: center; }
                    Text { text: h; color: Theme.text; font-size: Theme.small; font-family: Theme.ui-font; vertical-alignment: center; horizontal-alignment: left; overflow: elide; horizontal-stretch: 1; }
                }
                hta := TouchArea { clicked => { Ui.history-picked(h); } }
            }
        }
    }

    if Ui.finder-open: FinderPanel { }
    if Ui.dump-open: DumpPanel { }

    if Ui.hint-open: Rectangle {
        x: (root.width - self.width) / 2;
        y: 60px;
        width: min(root.width - 40px, ht.preferred-width + 60px);
        height: 38px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.5);
        border-radius: Theme.radius;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000090;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 8px;
            spacing: 8px;
            ht := Text { text: Ui.hint-text; color: Theme.text; font-size: Theme.small; font-family: Theme.ui-font; vertical-alignment: center; overflow: elide; }
            Rectangle { width: 22px; Text { text: "\u{E711}"; color: Theme.dim; font-size: 10px; font-family: Theme.icons; vertical-alignment: center; horizontal-alignment: center; } TouchArea { clicked => { Ui.hint-close(); } } }
        }
    }

    VerticalLayout {
        x: root.width - 380px;
        y: 62px;
        width: 360px;
        spacing: 6px;
        alignment: start;
        for t in Ui.toasts: Rectangle {
            height: tt.preferred-height + 20px;
            width: min(360px, max(140px, tm.preferred-width + 30px));
            x: 360px - self.width;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: Theme.radius;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000090;
            Rectangle { x: 0; y: 8px; width: 3px; height: parent.height - 16px; border-radius: 2px; background: t.kind == 1 ? Theme.good : t.kind == 2 ? Theme.bad : Theme.blue; }
            tm := Text { text: t.text; font-size: Theme.small; font-family: Theme.ui-font; visible: false; }
            tt := Text { x: 14px; y: 10px; width: parent.width - 26px; text: t.text; color: Theme.text; font-size: Theme.small; font-family: Theme.ui-font; wrap: word-wrap; }
        }
    }

    ContextMenu {
        open: Ui.menu-open;
        title: Ui.menu-title;
        entries: Ui.menu-entries;
        at-x: Ui.menu-x;
        at-y: Ui.menu-y;
        menu-w: Ui.menu-width;
        picked(id) => { Ui.menu-picked(id); }
        dismissed => { Ui.menu-dismissed(); }
    }

    dlg := Dialog {
        open: Ui.dialog-open;
        title: Ui.dialog-title;
        body: Ui.dialog-body;
        ok-label: Ui.dialog-ok;
        danger: Ui.dialog-danger;
        mode: Ui.dialog-mode;
        placeholder: Ui.dialog-placeholder;
        fields: Ui.dialog-fields;
        prompt-text <=> Ui.dialog-prompt;
        confirmed => { Ui.dialog-confirmed(); }
        cancelled => { Ui.dialog-cancelled(); }
        field-text(k, v) => { Ui.dialog-field-text(k, v); }
        field-select(k, i) => { Ui.dialog-field-select(k, i); }
        field-check(k, v) => { Ui.dialog-field-check(k, v); }
    }

    ShortcutsOverlay { open: Ui.shortcuts-open; rows: Ui.shortcut-rows; closed => { Ui.shortcuts-close(); } }

    if Tips.shown: Rectangle {
        x: min(Tips.x, root.width - self.width - 8px);
        y: min(Tips.y + 6px, root.height - self.height - 8px);
        width: min(420px, tipt.preferred-width + 20px);
        height: tipt.preferred-height + 12px;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 6px;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000090;
        tipt := Text { x: 10px; y: 6px; width: parent.width - 20px; text: Tips.text; color: Theme.text; font-size: Theme.small; font-family: Theme.ui-font; wrap: word-wrap; }
    }

    property <int> sfs: Ui.search-focus-seq;
    changed sfs => { search.focus-it(); search.select-all(); }
    property <int> pfs: Ui.prompt-focus-seq;
    changed pfs => { dlg.focus-prompt(); }
    property <int> kfs: Ui.keys-focus-seq;
    changed kfs => { keys.focus(); }
}
