import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DocItem, BoardRow, Badge, Metric } from "types.slint";
import { TipArea, BadgeView, MetricView, ChipButton } from "widgets.slint";
import { AreaChart } from "charts.slint";

export component Board inherits Rectangle {
    in property <[BoardRow]> rows;
    in property <bool> show-spark: true;
    in property <bool> show-io: true;
    in property <bool> show-who: true;
    in property <string> read-label: "Read";
    in property <string> write-label: "Write";
    in property <string> total-label;
    in property <string> empty-text;
    in property <string> empty-sub;
    callback clicked(int);
    callback double-clicked(int);
    callback right-clicked(int, length, length);
    background: transparent;
    VerticalLayout {
        Rectangle {
            height: 26px;
            background: Theme.head;
            Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line-soft; }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text { text: ""; width: 26px; }
                Text { text: "Process / file"; color: Theme.dim; font-size: 11px; font-family: Theme.ui-font; vertical-alignment: center; horizontal-stretch: 1; }
                if root.show-io: Text { text: root.read-label; color: Theme.blue; font-size: 11px; font-family: Theme.ui-font; vertical-alignment: center; horizontal-alignment: right; width: 80px; }
                if root.show-io: Text { text: root.write-label; color: Theme.warn; font-size: 11px; font-family: Theme.ui-font; vertical-alignment: center; horizontal-alignment: right; width: 80px; }
                if root.total-label != "": Text { text: root.total-label; color: Theme.dim; font-size: 11px; font-family: Theme.ui-font; vertical-alignment: center; horizontal-alignment: right; width: 80px; }
                if root.show-spark: Text { text: "6 s"; color: Theme.dim; font-size: 11px; font-family: Theme.ui-font; vertical-alignment: center; horizontal-alignment: right; width: 84px; }
            }
        }
        if root.rows.length == 0: Rectangle {
            VerticalLayout {
                alignment: center;
                padding: 20px;
                Text { text: root.empty-text; color: Theme.muted; font-size: Theme.font; horizontal-alignment: center; wrap: word-wrap; }
                Text { text: root.empty-sub; color: Theme.dim; font-size: Theme.small; horizontal-alignment: center; wrap: word-wrap; visible: root.empty-sub != ""; }
            }
        }
        ScrollView {
            VerticalLayout {
                alignment: start;
                for r[index] in root.rows: Rectangle {
                    height: 42px;
                    background: r.on ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
                    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line-soft; }
                    ta := TipArea {
                        tip: r.tip;
                        clicked => { root.clicked(index); }
                        double-clicked => { root.double-clicked(index); }
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                                root.right-clicked(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 0px;
                        Text { text: r.rank; color: Theme.dim; font-size: 11px; font-family: Theme.mono; width: 26px; vertical-alignment: center; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 1px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: r.label; color: Theme.text; font-size: Theme.font; font-family: Theme.ui-font; overflow: elide; vertical-alignment: center; }
                                if root.show-who && r.who != "": Text { text: r.who; color: Theme.dim; font-size: 11px; font-family: Theme.ui-font; overflow: elide; vertical-alignment: center; }
                            }
                            Text { text: r.sub; color: Theme.dim; font-size: 11px; font-family: Theme.ui-font; overflow: elide; }
                        }
                        if root.show-io: Text { text: r.read; color: Theme.blue; font-size: Theme.small; font-family: Theme.ui-font; horizontal-alignment: right; vertical-alignment: center; width: 80px; }
                        if root.show-io: Text { text: r.write; color: Theme.warn; font-size: Theme.small; font-family: Theme.ui-font; horizontal-alignment: right; vertical-alignment: center; width: 80px; }
                        if root.total-label != "": Text { text: r.total; color: Theme.muted; font-size: Theme.small; font-family: Theme.ui-font; horizontal-alignment: right; vertical-alignment: center; width: 80px; }
                        if root.show-spark: Rectangle {
                            width: 84px;
                            AreaChart { x: 12px; y: 9px; width: 66px; height: parent.height - 18px; line-path: r.spark; fill-path: r.spark-fill; line-color: Theme.blue; line-width: 1.2px; fill-alpha: 0.22; }
                        }
                    }
                }
            }
        }
    }
}

export component Doc inherits Rectangle {
    in property <[DocItem]> items;
    callback right-clicked(int, length, length);
    callback jump(int);
    callback button(string);
    background: transparent;
    ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 2px;
            alignment: start;
            for it[index] in root.items: VerticalLayout {
                if it.kind == 0: HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    padding-top: 12px;
                    padding-bottom: 4px;
                    Text { text: it.key; color: Theme.muted; font-size: 11px; font-weight: 700; letter-spacing: 0.6px; font-family: Theme.ui-font; }
                    Text { text: it.sub; color: Theme.dim; font-size: 11px; font-family: Theme.ui-font; visible: it.sub != ""; }
                }
                if it.kind == 1 || it.kind == 8: Rectangle {
                    background: kta.has-hover ? Theme.panel : transparent;
                    border-radius: 4px;
                    kta := TipArea {
                        tip: it.tip;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                                root.right-clicked(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding: 3px;
                        padding-left: 6px;
                        spacing: 10px;
                        HorizontalLayout {
                            width: 250px;
                            spacing: 6px;
                            alignment: start;
                            if it.kind == 8: Text { text: "●"; color: Theme.tone-color(it.tone); font-size: 9px; vertical-alignment: center; }
                            Text { text: it.key; color: Theme.muted; font-size: Theme.font; font-family: Theme.ui-font; overflow: elide; vertical-alignment: center; }
                            if it.badge != "": BadgeView { badge: { text: it.badge, kind: it.badge-kind, tip: "" }; y: (parent.height - self.height) / 2; }
                        }
                        Text {
                            text: it.value;
                            color: it.kind == 8 ? (it.tone == 1 ? Theme.dim : Theme.text) : it.tone == 0 ? Theme.text : Theme.tone-color(it.tone);
                            font-size: Theme.font;
                            font-family: it.id2 == "mono" ? Theme.mono : Theme.ui-font;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
                if it.kind == 2 || it.kind == 7: HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 2px;
                    padding-bottom: 6px;
                    spacing: 5px;
                    alignment: start;
                    for b[bi] in it.badges: Rectangle {
                        width: bv.width;
                        height: bv.height;
                        bv := BadgeView { badge: b; tone: it.kind == 7 ? 1 : -1; }
                        if it.kind == 7: TouchArea { mouse-cursor: pointer; clicked => { root.jump(b.kind); } }
                    }
                }
                if it.kind == 3: Rectangle {
                    height: 84px;
                    background: dta.has-hover ? Theme.panel2 : Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    border-radius: 8px;
                    dta := TipArea {
                        tip: "Right-click for actions";
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                                root.right-clicked(index, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    VerticalLayout {
                        padding: 10px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text { text: it.key; color: Theme.text; font-size: 14px; font-weight: 700; font-family: Theme.ui-font; }
                            Text { text: it.value; color: Theme.dim; font-size: Theme.small; font-family: Theme.ui-font; vertical-alignment: center; }
                        }
                        Text { text: it.sub; color: Theme.muted; font-size: Theme.small; font-family: Theme.ui-font; overflow: elide; visible: it.sub != ""; }
                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.line-soft;
                            visible: it.pct >= 0;
                            Rectangle { x: 0; width: parent.width * min(1.0, max(0.0, it.pct)); height: parent.height; border-radius: 3px; background: it.tone == 4 ? Theme.bad : it.tone == 3 ? Theme.warn : Theme.blue; }
                        }
                        Text { text: it.sub2; color: Theme.dim; font-size: 11px; font-family: Theme.ui-font; }
                    }
                }
                if it.kind == 4: Text {
                    text: it.value;
                    color: it.tone == 0 ? Theme.dim : Theme.tone-color(it.tone);
                    font-size: Theme.small;
                    font-family: Theme.ui-font;
                    wrap: word-wrap;
                }
                if it.kind == 5: HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    padding-bottom: 8px;
                    for b in it.badges: ChipButton { text: b.text; tip: b.tip; clicked => { root.button(b.text); } }
                }
            }
        }
    }
}
