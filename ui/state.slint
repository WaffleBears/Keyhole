    in-out property <string> board2-title: "Busiest processes";
    in-out property <string> board2-hint;
    in-out property <[BoardRow]> board2-rows;
    in-out property <string> board2-empty;
    in-out property <string> board2-empty-sub;
    in-out property <bool> board2-visible: true;
    in-out property <bool> board-spark: true;
    in-out property <string> board-total-label;
    in-out property <string> board-read-label: "Read";
    in-out property <string> board-write-label: "Write";
    callback layer-changed(string);
    callback bar-link-clicked();
    callback board-clicked(string, int);
    callback board-double(string, int);
    callback board-right(string, int, length, length);

    in-out property <[DocItem]> env-doc;
    in-out property <[Metric]> res-metrics;
    in-out property <string> res-cpu-path;
    in-out property <string> res-cpu-fill;
    in-out property <string> res-kernel-path;
    in-out property <string> res-kernel-fill;
    in-out property <string> res-cpu-scale;
    in-out property <string> res-mem-path;
    in-out property <string> res-mem-fill;
    in-out property <string> res-commit-path;
    in-out property <string> res-commit-fill;
    in-out property <string> res-mem-scale;
    in-out property <[BarRow]> res-cores;
    in-out property <[BarRow]> res-mem-doc;
    in-out property <[BarRow]> res-devices;
    in-out property <string> res-devices-hint;

    in-out property <bool> finder-open;
    in-out property <bool> dump-open;
    in-out property <bool> dump-loading;
    in-out property <string> dump-title;
    in-out property <string> dump-kind;
    in-out property <string> dump-verdict;
    in-out property <int> dump-verdict-tone;
    in-out property <[DocItem]> dump-doc;
    callback dump-close();
    callback dump-copy();
    callback dump-save();
    callback dump-doc-right(int, length, length);
    in-out property <string> finder-query;
    in-out property <string> finder-foot;
    in-out property <bool> finder-subtree;
    in-out property <bool> finder-loading;
    in-out property <[Chip]> finder-chips;
    in-out property <[[Chip]]> finder-chips-more;
    in-out property <string> finder-chip;
    in-out property <[Col]> finder-cols;
    in-out property <[Row]> finder-rows;
    in-out property <length> finder-fixed;
    in-out property <string> finder-sort;
    in-out property <bool> finder-desc;
    callback finder-close();
    callback finder-rerun();
