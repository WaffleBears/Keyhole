import { BarRow, Row, Col, Chip, Badge, MenuEntry, DocItem, BoardRow, Metric, Pill, StatusPart, Toast, FormField, TabInfo, ShortcutRow } from "types.slint";

export global Ui {
    in-out property <string> window-title: "Keyhole";
    in-out property <length> win-width: 1380px;
    in-out property <length> win-height: 880px;
    in-out property <length> rail-height;
    in-out property <length> rail-content;
    in-out property <string> mode: "processes";
    in-out property <[StatusPart]> status-parts;
    in-out property <[Pill]> pills;
    in-out property <string> pause-label: "Live";
    in-out property <int> pause-dot: 1;
    in-out property <bool> pause-active;
    in-out property <bool> live-view: true;
    in-out property <int> rate-index: 1;
    in-out property <[string]> rate-options: ["0.5s", "1s", "2s", "5s", "10s", "Manual"];
    in-out property <[Toast]> toasts;
    in-out property <string> search-text;
    in-out property <[string]> search-history;
    callback history-picked(string);
    in-out property <string> hint-text;
    in-out property <bool> hint-open;
    callback set-mode(string);
    callback pause-clicked();
    callback rate-changed(int);
    callback refresh-clicked();
    callback export-clicked(length, length);
    callback help-clicked();
    callback search-submitted(string);
    callback window-resized();
    callback pill-clicked(string);
    callback key-pressed(string, bool, bool) -> bool;
    callback hint-close();
    callback browse-clicked();

    in-out property <[Col]> tree-cols;
    in-out property <[Row]> tree-rows;
    in-out property <length> tree-fixed;
    in-out property <string> tree-sort: "name";
    in-out property <bool> tree-desc;
    in-out property <string> tree-count;
    in-out property <string> tree-empty-text;
    in-out property <string> tree-empty-sub;
    in-out property <bool> tree-flat;
    in-out property <string> tree-filter;
    in-out property <length> tree-height: 380px;
    callback tree-sort-clicked(string);
    callback tree-resize(int, length);
    callback tree-resized-done();
    callback tree-clicked(int);
    callback tree-double(int);
    callback tree-right(int, length, length);
    callback tree-twisty(int);
    callback tree-header-right(length, length);
    callback tree-filter-edited(string);
    callback tree-flat-changed(bool);
    callback collapse-all();
    callback expand-all();

    in-out property <bool> sel-visible;
    in-out property <string> sel-name: "No process selected";
    in-out property <string> sel-sub: "Click a process above to inspect what it has open.";
    in-out property <[Badge]> sel-badges;
    in-out property <image> sel-icon;
    in-out property <bool> sel-has-icon;
    in-out property <string> cpu-path;
    in-out property <string> cpu-fill;
    in-out property <int> cpu-tone;
    in-out property <string> cpu-text: "-";
    in-out property <string> priv-text: "-";
    in-out property <string> ws-text: "-";
    in-out property <string> handles-text: "-";
    in-out property <string> threads-text: "-";
    in-out property <string> suspend-label: "Suspend";
    in-out property <string> suspend-tip;
    callback dh-suspend();
    callback dh-kill();
    callback dh-more(length, length);

    in-out property <[TabInfo]> tabs;
    in-out property <string> tab: "handles";
    in-out property <string> detail-filter;
    in-out property <bool> named-only: true;
    in-out property <bool> resolve-dns;
    in-out property <bool> show-named: true;
    in-out property <bool> show-dns;
    in-out property <bool> show-detail-filter: true;
    in-out property <[Chip]> type-chips;
    in-out property <[[Chip]]> type-chips-more;
    in-out property <string> type-chip;
    in-out property <string> chip-note;
    in-out property <bool> detail-loading;
    in-out property <[Col]> detail-cols;
    in-out property <[Row]> detail-rows;
    in-out property <length> detail-fixed;
    in-out property <string> detail-sort;
    in-out property <bool> detail-desc;
    in-out property <string> detail-empty-icon;
    in-out property <string> detail-empty-text;
    in-out property <string> detail-empty-sub;
    in-out property <bool> detail-is-doc;
    in-out property <[DocItem]> detail-doc;
    callback tab-clicked(string);
    callback detail-sort-clicked(string);
    callback detail-resize(int, length);
    callback detail-resized-done();
    callback detail-clicked(int);
    callback detail-double(int);
    callback detail-right(int, length, length);
    callback detail-filter-edited(string);
    callback named-toggled(bool);
    callback dns-toggled(bool);
    callback type-chip-picked(string);
    callback doc-right(string, int, length, length);
    callback doc-jump(int);
    callback doc-button(string, string);
    callback env-filter-edited(string);
    in-out property <string> env-filter;

    in-out property <string> list-title;
    in-out property <string> list-count;
    in-out property <[Col]> list-cols;
    in-out property <[Row]> list-rows;
    in-out property <length> list-fixed;
    in-out property <string> list-sort;
    in-out property <bool> list-desc;
    in-out property <[Chip]> list-chips;
    in-out property <[[Chip]]> list-chips-more;
    in-out property <string> list-chip;
    in-out property <string> list-filter;
    in-out property <string> list-filter-placeholder: "Filter";
    in-out property <string> list-filter-tip;
    in-out property <bool> list-loading;
    in-out property <string> list-empty-icon;
    in-out property <string> list-empty-text;
    in-out property <string> list-empty-sub;
    in-out property <[Chip]> list-buttons;
    in-out property <[Chip]> list-segments;
    in-out property <string> list-segment;
    in-out property <string> list-toggle-label;
    in-out property <string> list-toggle-tip;
    in-out property <bool> list-toggle-visible;
    in-out property <bool> list-toggle-checked;
    callback list-sort-clicked(string);
    callback list-resize(int, length);
    callback list-resized-done();
    callback list-clicked(int);
    callback list-double(int);
    callback list-right(int, length, length);
    callback list-filter-edited(string);
    callback list-chip-picked(string);
    callback list-button(string);
    callback list-segment-picked(string);
    callback list-toggle(bool);

    in-out property <[Metric]> bar-metrics;
    in-out property <string> bar-text;
    in-out property <string> bar-text2;
    in-out property <int> bar-text-tone;
    in-out property <string> bar-link;
    in-out property <bool> show-timeline;
    in-out property <string> tl-read-path;
    in-out property <string> tl-read-fill;
    in-out property <string> tl-write-path;
    in-out property <string> tl-write-fill;
    in-out property <string> tl-scale;
    in-out property <string> tl-read-label: "read";
    in-out property <string> tl-write-label: "write";
    in-out property <string> tl-tip;
    in-out property <string> layer: "file";
