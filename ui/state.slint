    callback dialog-field-select(string, int);
    callback dialog-field-check(string, bool);

    in-out property <bool> shortcuts-open;
    in-out property <[ShortcutRow]> shortcut-rows;
    callback shortcuts-close();

    in-out property <int> tree-scroll-index;
    in-out property <int> tree-scroll-seq;
    in-out property <int> finder-scroll-index;
    in-out property <int> finder-scroll-seq;
    in-out property <int> list-scroll-index;
    in-out property <int> list-scroll-seq;
    in-out property <int> search-focus-seq;
    in-out property <int> prompt-focus-seq;
