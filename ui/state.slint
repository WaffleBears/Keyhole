    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in-out property <length> menu-width: 300px;
    callback menu-picked(string);
    callback menu-dismissed();

    in-out property <bool> dialog-open;
    in-out property <string> dialog-title;
    in-out property <string> dialog-body;
    in-out property <string> dialog-ok: "Continue";
    in-out property <bool> dialog-danger: true;
    in-out property <int> dialog-mode;
    in-out property <string> dialog-placeholder;
    in-out property <[FormField]> dialog-fields;
    in-out property <string> dialog-prompt;
